APP_NAME=Laravel
APP_VERSION=2.5.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# When sharing the app over VS Code port forwarding, point APP_URL at the
# forwarded app port (https://<id>-8000.<region>.devtunnels.ms) and set
# VITE_DEV_ORIGIN to the forwarded *5173* port. APP_URL is what queued
# notifications, `tims:send-reminders` and released certificate PDFs use to
# build links, since those run outside a request and cannot infer the host.
# Certificates are rendered once and never re-rendered, so a wrong APP_URL is
# baked into any document issued while it was wrong.
# VITE_DEV_ORIGIN=

# `artisan serve` otherwise binds and announces 127.0.0.1, which is a different
# origin than APP_URL as far as cookies go. Google sends the OAuth callback to
# GOOGLE_REDIRECT_URI (localhost), so a flow begun on 127.0.0.1 arrives without
# the session cookie holding Socialite's state and fails the CSRF check.
SERVER_HOST=localhost

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Public office identity, rendered in the site footer. Anything left blank is
# omitted rather than guessed — see config/office.php.
OFFICE_NAME="Civil Service Commission Regional Office VIII"
OFFICE_SHORT_NAME="CSC RO VIII"
OFFICE_REGION="Eastern Visayas"
OFFICE_ADDRESS="Government Center, Candahug, Palo, Leyte"
OFFICE_PHONE=
OFFICE_EMAIL=ro08.hrd@csc.gov.ph
# Optional. Leave blank and the seal is embedded in each message, which works on
# any host. Set an absolute, publicly reachable URL to link it from a CDN instead.
MAIL_LOGO_URL=
