# This file is the local-development template — `composer setup` copies it
# straight to .env. A production deploy must not just copy it verbatim:
# APP_ENV=production, APP_DEBUG=false (a debug page leaks stack traces, SQL,
# and .env values to any visitor who can trigger a 500), and SESSION_SECURE_COOKIE
# below should be set true once the deployment is actually served over HTTPS.
APP_NAME=Laravel
APP_VERSION=2.5.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# APP_URL is the root of EVERY URL this app generates. AppServiceProvider pins
# it with URL::forceRootUrl(), so the Host header cannot decide where a link
# points — it used to, and a forged Host on POST /forgot-password put a working
# password-reset token on the attacker's domain, inside a genuine email from
# this office. Only the scheme still follows the request, which is what lets a
# trusted proxy's X-Forwarded-Proto produce https:// links.
#
# Two consequences. Certificates are rendered once and never re-rendered, so a
# wrong APP_URL is baked into any document issued while it was wrong. And when
# sharing the app over VS Code port forwarding you MUST point APP_URL at the
# forwarded app port (https://<id>-8000.<region>.devtunnels.ms), or every link
# in the app points at localhost; set VITE_DEV_ORIGIN to the forwarded *5173*
# port at the same time.
# VITE_DEV_ORIGIN=

# Which proxies may set X-Forwarded-* on this deployment. Empty means trust
# none, which is the safe default: X-Forwarded-For is what every IP-keyed
# `throttle:` in routes/web.php counts against, so trusting it from anywhere
# lets a client pick its own rate-limit bucket by picking its own header.
#
# Read by config/trustedproxy.php. It cannot be read in bootstrap/app.php —
# that closure runs before .env is parsed, so env() there always returns its
# default. This setting lived in exactly that spot and had never once taken
# effect, in any environment.
#
# Set it to `*` when running behind a VS Code / ngrok / Cloudflare tunnel on a
# machine nothing else can reach — without it the tunnel's https is invisible
# to Laravel and asset() emits http:// URLs the browser blocks as mixed
# content. In production name the actual proxy addresses instead, comma
# separated: TRUSTED_PROXIES=10.0.0.4,10.0.0.5
# TRUSTED_PROXIES=

# `artisan serve` otherwise binds and announces 127.0.0.1, which is a different
# origin than APP_URL as far as cookies go. Google sends the OAuth callback to
# GOOGLE_REDIRECT_URI (localhost), so a flow begun on 127.0.0.1 arrives without
# the session cookie holding Socialite's state and fails the CSRF check.
SERVER_HOST=localhost

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# LOG_STACK=single writes one file that grows without bound — a slow disk-fill,
# and once it is large, a file nobody can search. Use "daily" in production,
# where LOG_DAILY_DAYS sets the retention. Move LOG_LEVEL up to "warning" there
# too: "debug" logs query-level detail, which on this application means
# participant data sitting in a file with a wider audience than the database.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_STACK=daily
# LOG_DAILY_DAYS=14
# LOG_LEVEL=warning

# Authentication events (sign-in, failed sign-in, lockout, sign-out) go to their
# own channel at storage/logs/auth.log, kept far longer than the application log
# because "how many failed attempts preceded this compromise" is asked months
# later. Never contains a password.
# LOG_AUTH_DAYS=180

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Left unset (sends the cookie over HTTP or HTTPS) so local `artisan serve`
# still works. Set to true once the deployment is actually served over HTTPS —
# otherwise the session cookie can be sent in the clear on an HTTP fallback.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Security response headers — see config/security.php and the SecurityHeaders
# middleware. X-Frame-Options, nosniff, Referrer-Policy and Permissions-Policy
# are always sent and need no configuration; these two are the staged parts.
#
# The Content-Security-Policy ships REPORT-ONLY. Watch the browser console (or
# point CSP_REPORT_URI at a collector) on a real deployment, confirm nothing is
# being blocked, then set CSP_ENFORCE=true. Enforcing an incomplete policy fails
# silently and totally — a blocked module script leaves a blank page.
# CSP_ENFORCE=false
# CSP_REPORT_URI=
#
# HSTS is sent only on requests that actually arrived over HTTPS, so it is
# harmless before TLS exists. Set HSTS_ENABLED=false only for a deployment that
# is deliberately served over plain HTTP.
# HSTS_ENABLED=true
# HSTS_MAX_AGE=31536000

# Public office identity, rendered in the site footer, in outgoing mail, and on
# issued certificates. Anything left blank is omitted rather than guessed — see
# config/office.php.
#
# Set these before releasing a single certificate. A certificate is rendered
# once and stored, so the office named on it cannot be corrected afterwards —
# unlike every other identity string here, which re-renders on the next page
# load.
OFFICE_NAME="Civil Service Commission Regional Office VIII"
OFFICE_SHORT_NAME="CSC RO VIII"
OFFICE_REGION="Eastern Visayas"
# The same region as the PSA spells it, matched against participants' profiles
# to decide who is outside this office's region. Must be one of the names in
# App\Support\PhilippineGeography exactly — tims:doctor checks it, because an
# unrecognised value matches nobody and quietly makes outsiders of everyone.
OFFICE_PSGC_REGION="Region VIII (Eastern Visayas)"
OFFICE_ADDRESS="Government Center, Candahug, Palo, Leyte"
OFFICE_PHONE=
OFFICE_EMAIL=ro08.hrd@csc.gov.ph

# The prefix on printed certificate numbers (CSC8-2026-000042). The 8 is the
# region. Changing it affects certificates issued from then on; numbers already
# assigned keep matching the paper copies.
OFFICE_CERTIFICATE_PREFIX=CSC8
# Optional. Leave blank and the seal is embedded in each message, which works on
# any host. Set an absolute, publicly reachable URL to link it from a CDN instead.
MAIL_LOGO_URL=

# Nightly archive of the database plus storage/app/private (tims:backup, 02:00).
#
# Both of the settings below are REQUIRED in production — `tims:backup` refuses
# to run without them rather than silently writing an archive that should not
# exist. BACKUP_PATH must be outside the application directory, or the archive
# dies with the disk it is protecting against losing; getting it onto another
# machine (a mapped drive, a synced folder) is still an ops step the command
# cannot take for you.
#
# BACKUP_PASSWORD encrypts the archive with AES-256, which any ordinary tool
# opens — a recovery that needs the application currently on fire is not a
# recovery. Keep the password somewhere OTHER than this server: an archive
# encrypted with a key that only exists on the machine it protects is a locked
# box with the key inside it.
#
# MYSQLDUMP_PATH / MYSQL_PATH are only needed where the binaries are neither on
# PATH nor at the XAMPP location. MYSQL_PATH is what `tims:restore` uses.
# BACKUP_PATH=
# BACKUP_PASSWORD=
# BACKUP_KEEP_DAYS=14
# MYSQLDUMP_PATH=
# MYSQL_PATH=
